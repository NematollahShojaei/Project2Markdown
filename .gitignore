# ==========================================
# Project2Markdown (P2M) - Git Ignore Rules
# ==========================================

# 1. Compiled Binaries (Windows, Linux, Mac)
/p2m
/p2m-cli
/p2m-gui
/p2m.exe
/p2m-cli.exe
/p2m-gui.exe
/project2markdown
/project2markdown-cli
/project2markdown-gui
project2markdown.exe
/project2markdown-cli.exe
/project2markdown-gui.exe

# 2. Generated Markdown Context Files
# Prevents the AI context files from being committed to the repo
*_context.md

# 3. Go Winres Generated Resource Files
# We intentionally KEEP *.syso files in the repository.
# This ensures that anyone cloning the repo can build the app with the Windows icon out-of-the-box without needing to install go-winres.

# 4. Go Dependencies & Workspaces
vendor/
go.work
go.work.sum

# 5. IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# 6. OS Specific Files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# 7. Environment Variables (Security)
.env
.env.local
